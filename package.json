{
  "name": "superaudio-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "rimraf node_modules **/*/node_modules"
  },
  "devDependencies": {
    "turbo": "latest",
    "rimraf": "latest"
  },
  "packageManager": "yarn@1.22.19"
}